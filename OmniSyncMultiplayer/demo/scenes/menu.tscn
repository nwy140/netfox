[sub_resource type="GDScript" id="GDScript_uylvf"]
resource_name = "Menu"
script/source = "extends Control

@onready var play_button: TextureButton = $CenterContainer/PlayButton
@onready var timer_label: RichTextLabel = $MarginContainer/Timer

const GAME_SCENE = \"uid://ctoysbafhx4tj\"

var matchmaking_time: float = 0.0

func _ready() -> void:
	var args := OS.get_cmdline_user_args()
	if \"--g1-walk-smoke\" in args or \"--g1-checkpoint-smoke\" in args:
		get_tree().change_scene_to_file.call_deferred(\"res://UnitreeG1Walk.tscn\")
		return
	OmniManager.debug_mode = OmniManager.DEBUG.INFO
	var g1_button := Button.new()
	g1_button.text = \"G1 Multiplayer\"
	g1_button.position = Vector2(24, 24)
	add_child(g1_button)
	g1_button.pressed.connect(func() -> void:
		get_tree().change_scene_to_file(\"res://G1MultiplayerLobby.tscn\"))
	
	# Stop _process until matchmaking starts
	set_process(false)
	timer_label.hide()
	
	_setup_signals()
	_update_play_button_state()


func _process(delta: float) -> void:
	matchmaking_time += delta
	timer_label.text = _format_time(matchmaking_time)


# --- Signal Setup ---

func _setup_signals() -> void:
	play_button.pressed.connect(_on_play_button_pressed)
	
	OmniManager.eos_logged_in.connect(_on_eos_logged_in)
	OmniManager.match_found.connect(_on_match_found)
	OmniManager.eos_error.connect(_on_eos_error)


# --- UI & State Helpers ---

func _update_play_button_state() -> void:
	play_button.disabled = not OmniManager.is_logged_in


func _start_matchmaking_timer() -> void:
	matchmaking_time = 0.0
	timer_label.text = _format_time(0.0)
	timer_label.show()
	set_process(true)


func _stop_matchmaking_timer() -> void:
	set_process(false)
	timer_label.hide()


func _format_time(time_in_seconds: float) -> String:
	var total_seconds: int = int(time_in_seconds)
	var minutes: int = floori(total_seconds / 60.0)
	var seconds: int = total_seconds % 60
	return \"%02d:%02d\" % [minutes, seconds]


# --- Callbacks ---

func _on_play_button_pressed() -> void:
	play_button.disabled = true
	_start_matchmaking_timer()
	OmniManager.search_for_match()


func _on_eos_logged_in(_puid: Variant) -> void:
	play_button.disabled = false


func _on_match_found() -> void:
	_stop_matchmaking_timer()
	
	# Transition to the game scene here
	get_tree().change_scene_to_file(GAME_SCENE)


func _on_eos_error(context: String, msg: String) -> void:
	if context == \"Matchmaking\":
		printerr(\"Matchmaking Error: %s\" % msg)
		_stop_matchmaking_timer()
		play_button.disabled = false
"

