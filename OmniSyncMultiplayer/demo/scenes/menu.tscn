[sub_resource type="GDScript" id="GDScript_6gfqm"]
resource_name = "ButtonAnimator"
script/source = "extends TextureButton

const NORMAL_SCALE: Vector2 = Vector2(0.9, 0.9)
const DOWN_SCALE: Vector2 = Vector2(0.8, 0.8)
const TWEEN_DURATION: float = 0.35

var tween: Tween
var is_mouse_inside: bool = false
var is_pressed_down: bool = false
var is_mobile: bool = false

func _ready() -> void:
	await get_tree().create_timer(0.1).timeout
	scale = NORMAL_SCALE
	pivot_offset_ratio = Vector2.ONE/2
	button_down.connect(func() -> void:
		_scale_tween(DOWN_SCALE)
	)
	button_up.connect(func() -> void:
		_scale_tween(NORMAL_SCALE)
	)
	
func _scale_tween(target_scale: Vector2) -> void:
	if tween: tween.kill()
	tween = create_tween()
	tween.tween_property(self, \"scale\", target_scale, TWEEN_DURATION).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_EXPO)
"

