[sub_resource type="GDScript" id="GDScript_pjiy7"]
resource_name = "Game"
script/source = "extends Node2D

@export var player_scene: PackedScene

const MENU_SCENE = \"uid://blefbnf0t16v6\"

@onready var player_positions: Node2D = $PlayerPositions
@onready var player_container: Node2D = $PlayerContainer
@onready var spawner: MultiplayerSpawner = $Spawner
@onready var label: RichTextLabel = $UI/Control/MarginContainer/Ping
@onready var background: Node2D = $Background

var _is_returning_to_menu: bool = false
var _game_started: bool = false
var _migration_timeout_timer: SceneTreeTimer = null

func _is_server() -> bool:
	return multiplayer.has_multiplayer_peer() and multiplayer.is_server()

func _ready() -> void:
	# Configure background
	background.global_position = get_viewport_rect().size/2
	
	# Configure custom spawn function for MultiplayerSpawner
	spawner.spawn_function = _custom_spawn_player
	
	# Listen for peer connects and disconnects
	multiplayer.peer_connected.connect(_on_peer_connected)
	multiplayer.peer_disconnected.connect(_on_peer_disconnected)
	multiplayer.server_disconnected.connect(_on_server_disconnected)
	multiplayer.connection_failed.connect(_on_connection_failed)
	
	# Listen for match lifecycle and host migration
	OmniManager.match_ended.connect(_on_match_ended)
	OmniManager.host_migrated.connect(_on_host_migrated)
	
	if not multiplayer.has_multiplayer_peer():
		return
	
	_game_started = true
	
	if _is_server():
		spawn_player(1)
		for p_id in multiplayer.get_peers():
			spawn_player(p_id)
	else:
		# Client signals host only when connected
		if multiplayer.multiplayer_peer and multiplayer.multiplayer_peer.get_connection_status() == MultiplayerPeer.CONNECTION_CONNECTED:
			player_loaded.rpc_id(1)
		else:
			multiplayer.connected_to_server.connect(func() -> void:
				player_loaded.rpc_id(1)
			, CONNECT_ONE_SHOT)


func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_RESUMED or what == NOTIFICATION_APPLICATION_FOCUS_IN:
		_check_connection_health.call_deferred()


func _check_connection_health() -> void:
	if not is_inside_tree() or _is_returning_to_menu:
		return
	await get_tree().create_timer(0.3).timeout
	if not is_inside_tree() or _is_returning_to_menu:
		return
	
	if OmniManager.is_migrating_host:
		return
	
	if OmniManager.current_lobby == null and not _is_server():
		_return_to_menu()


func _physics_process(_delta: float) -> void:
	if _is_returning_to_menu:
		return

	if OmniManager.is_migrating_host:
		label.text = \"Migrating host...\"
		return

	if not multiplayer.has_multiplayer_peer():
		return

	# If match was active, no migration is running, and lobby was terminated
	if _game_started and OmniManager.current_lobby == null and not _is_server():
		_return_to_menu()
		return

	# Update ping display (0ms on Host, actual RTT on Clients)
	var ping: int = OmniManager.get_host_latency_ms()
	label.text = str(\"Ping: %dms\" % ping) if ping >= 0 else \"Ping: -- ms\"


# ==============================================================================
# SPAWNING & MULTIPLAYER
# ==============================================================================

@rpc(\"any_peer\", \"call_local\", \"reliable\")
func player_loaded(custom_position: Vector2 = Vector2.ZERO) -> void:
	if not _is_server():
		return
	var sender_id: int = multiplayer.get_remote_sender_id()
	spawn_player(sender_id, custom_position)


func spawn_player(id: int, custom_position: Vector2 = Vector2.ZERO) -> void:
	if not _is_server():
		return
	if player_container.has_node(str(id)):
		return
	
	# Pick position: custom position (e.g. migration) or spawn marker
	var pos := custom_position
	if pos == Vector2.ZERO and player_positions:
		var spawn_index: int = OmniManager.get_player_slot(id)
		var spawn_count: int = player_positions.get_child_count()
		if spawn_count > 0:
			var spawn_node := player_positions.get_child(spawn_index % spawn_count) as Node2D
			pos = spawn_node.global_position
	
	# MultiplayerSpawner replicates the instantiated player to all peers
	spawner.spawn({
		\"id\": id,
		\"position\": pos
	})


func _custom_spawn_player(data: Dictionary) -> Node:
	var player: Node2D = player_scene.instantiate()
	player.name = str(data[\"id\"])
	player.position = data[\"position\"]
	return player


func _on_peer_connected(id: int) -> void:
	if _is_server():
		spawn_player(id)


func _on_peer_disconnected(id: int) -> void:
	# Server despawns players who disconnect during match
	if _is_server():
		var player_node := player_container.get_node_or_null(str(id))
		if player_node:
			player_node.queue_free()


func _on_server_disconnected() -> void:
	# If host migration is active or lobby exists, start migration watchdog
	if OmniManager.is_migrating_host or OmniManager.current_lobby != null:
		_start_migration_watchdog(6.0)
		return
	_return_to_menu()


func _on_connection_failed() -> void:
	_return_to_menu()


func _on_match_ended(_reason: String = \"\") -> void:
	_return_to_menu()


func _start_migration_watchdog(timeout_sec: float) -> void:
	_migration_timeout_timer = get_tree().create_timer(timeout_sec)
	_migration_timeout_timer.timeout.connect(func() -> void:
		if _is_returning_to_menu:
			return
		if OmniManager.is_migrating_host or not multiplayer.has_multiplayer_peer() or multiplayer.multiplayer_peer.get_connection_status() != MultiplayerPeer.CONNECTION_CONNECTED:
			_return_to_menu()
	)


func _return_to_menu() -> void:
	if _is_returning_to_menu:
		return
	_is_returning_to_menu = true
	set_physics_process(false)
	set_process(false)
	
	if OmniManager.current_lobby != null or multiplayer.has_multiplayer_peer():
		OmniManager.leave_match(\"Disconnected from game session.\")
	
	get_tree().change_scene_to_file(MENU_SCENE)


# ==============================================================================
# HOST MIGRATION
# ==============================================================================

func _on_host_migrated(_new_host_puid: String, is_local_host: bool) -> void:
	_migration_timeout_timer = null
	
	# 1. Preserve our current player position from OmniManager (continuous authority snapshot)
	var my_saved_pos := OmniManager.last_saved_position
	if my_saved_pos == Vector2.ZERO:
		var my_old_node = player_container.get_node_or_null(str(OmniManager.last_peer_id))
		if my_old_node and is_instance_valid(my_old_node) and my_old_node is Node2D:
			my_saved_pos = my_old_node.global_position
		else:
			for child in player_container.get_children():
				if is_instance_valid(child) and child is CharacterBody2D:
					my_saved_pos = child.global_position
					break
	
	# 2. Immediately remove all player nodes from the previous server session
	for child in player_container.get_children():
		player_container.remove_child(child)
		child.queue_free()
	
	# 3. Spawn at preserved position
	if is_local_host:
		# Respawn ourselves as peer 1 (Host) with full authority
		if my_saved_pos != Vector2.ZERO:
			spawn_player(1, my_saved_pos)
		else:
			spawn_player(1)
	else:
		# Tell the new host we are connected and pass our saved position
		player_loaded.rpc_id(1, my_saved_pos)
"

