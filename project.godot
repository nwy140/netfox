; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Multiplayer Template"
config/description="Network addon with rollback"
run/main_scene="res://G1MultiplayerLobby.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
run/max_fps=240
boot_splash/image="uid://dh2xh1r1ybepi"
config/icon="uid://b8tr1o6ltkygc"

[autoload]

Async="*res://examples/shared/scripts/async.gd"
GameEvents="*res://examples/forest-brawl/scripts/game-events.gd"
EOSGRuntime="*res://addons/omni-sync/runtime.gd"
HPlatform="*res://addons/omni-sync/heos/hplatform.gd"
HAuth="*res://addons/omni-sync/heos/hauth.gd"
HAchievements="*res://addons/omni-sync/heos/hachievements.gd"
HFriends="*res://addons/omni-sync/heos/hfriends.gd"
HStats="*res://addons/omni-sync/heos/hstats.gd"
HLeaderboards="*res://addons/omni-sync/heos/hleaderboards.gd"
HLobbies="*res://addons/omni-sync/heos/hlobbies.gd"
HP2P="*res://addons/omni-sync/heos/hp2p.gd"
HSessions="*res://addons/omni-sync/heos/hsessions.gd"
OmniManager="*res://addons/omni-sync/scripts/OmniManager.gd"
EnvLoader="*res://addons/omni-sync/android/env.gd"
EOSCreds="*res://addons/omni-sync/scripts/Credentials.gd"
WindowTiler="*res://addons/netfox.extras/window-tiler.gd"
Noray="*res://addons/netfox.noray/noray.gd"
PacketHandshake="*res://addons/netfox.noray/packet-handshake.gd"
NetworkTime="*res://addons/netfox/network-time.gd"
NetworkTimeSynchronizer="*res://addons/netfox/network-time-synchronizer.gd"
NetworkRollback="*res://addons/netfox/rollback/network-rollback.gd"
NetworkEvents="*res://addons/netfox/network-events.gd"
NetworkPerformance="*res://addons/netfox/network-performance.gd"
NetworkSimulator="*res://addons/netfox.extras/network-simulator.gd"
RollbackSimulationServer="*res://addons/netfox/servers/rollback-simulation-server.gd"
NetworkHistoryServer="*res://addons/netfox/servers/network-history-server.gd"
NetworkSynchronizationServer="*res://addons/netfox/servers/network-synchronization-server.gd"
NetworkIdentityServer="*res://addons/netfox/servers/network-identity-server.gd"
NetworkCommandServer="*res://addons/netfox/servers/network-command-server.gd"
RollbackLivenessServer="*res://addons/netfox/servers/rollback-liveness-server.gd"
InterpolationServer="*res://addons/netfox/servers/interpolation-server.gd"

[blazium]

justamcp/server_enabled=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=540
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Multiplayer Template"

[editor_plugins]

enabled=PackedStringArray("res://addons/omni-sync/plugin.cfg", "res://addons/netfox.extras/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox/plugin.cfg", "res://addons/mj_robot_import/plugin.cfg", "res://addons/netfox.noray/plugin.cfg", "res://addons/nohub.gd/plugin.cfg", "res://addons/trimsock.gd/plugin.cfg", "res://addons/vest/plugin.cfg")

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

[global_group]

players=""

[gui]

common/auto_focus_strategy=1
theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true
fonts/compatibility/msdf_legacy_scaling=true

