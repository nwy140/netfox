[input_devices]

joypads/ignore_joypad_on_unfocused_application=true
pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="floor"
3d_physics/layer_2="player"
3d_physics/layer_3="ball"
3d_physics/layer_4="goal"

[netfox]

extras/auto_tile_windows=false
extras/borderless=true
extras/screen=1
general/clear_settings=false
time/tickrate=24
rollback/enable_diff_states=true
events/enabled=true

[physics]

common/max_physics_steps_per_frame=64
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/multi_bounce_occlusion/enabled=true
anti_aliasing/quality/screen_space_aa=1

[vest]

tests_root="res://test/"
new_test_location=2
